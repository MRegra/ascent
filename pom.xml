<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.sobatista.ascent</groupId>
  <artifactId>ascent-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>Ascent</name>
  <description>A cost-aware load balancer and autoscaler for a CPU-intensive search workload — it weighs each request by instrumenting the solver's bytecode, routes by estimated cost, and scales workers to match.</description>
  <url>https://github.com/MRegra/ascent</url>
  <licenses>
    <license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license>
  </licenses>

  <modules>
    <module>ascent-solver</module>
    <module>ascent-meter</module>
    <module>ascent-cloud</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <asm.version>9.7.1</asm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId><artifactId>junit-bom</artifactId>
        <version>${junit.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency><groupId>dev.sobatista.ascent</groupId><artifactId>ascent-solver</artifactId><version>0.2.0</version></dependency>
      <dependency><groupId>dev.sobatista.ascent</groupId><artifactId>ascent-meter</artifactId><version>0.2.0</version></dependency>
      <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>${asm.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
